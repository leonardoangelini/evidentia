# OAuth 2.0 client id (type "Web application") compiled into the build for
# Google Docs support. Redirect URI to register in Google Cloud:
#   https://<extension-id>.chromiumapp.org/
# Leave unset to ship without a default: each teacher/school can enter a
# client id in the extension settings. See docs/google-docs.md.
WXT_GOOGLE_CLIENT_ID=

# Base64 DER public key that pins the extension id of local builds, so the
# OAuth redirect URI stays the same across paths and profiles. Generate:
#   openssl genrsa -out key.pem 2048
#   openssl rsa -in key.pem -pubout -outform DER | base64 | tr -d '\n'
# Leave unset in CI: the Web Store assigns the id of the published extension.
# In locale conviene incollare qui la chiave pubblica dell'item **testing**
# mostrata dalla dashboard del Web Store: le build locali assumono l'id di
# testing, un solo redirect URI OAuth, e non condividono mai identità e dati
# con l'estensione pubblica.
WXT_EXTENSION_KEY=

# Canale di build: testing (default) | production. Decide nome visibile e
# version del pacchetto, non il codice. In locale lascialo su testing: la
# produzione la costruisce solo la CI, quando pubblichi una Release.
EVIDENTIA_CHANNEL=testing
